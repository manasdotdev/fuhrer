{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["./node_modules", "./dist"],
  "bracketSameLine": true,
  "printWidth": 180,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "jsxSingleQuote": true,
  "arrowParens": "always",
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./src/index.css",
    "functions": ["clsx", "cn"],
    "preserveWhitespace": true
  }
}
